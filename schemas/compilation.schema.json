{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        },
        "required": [
          "code",
          "message",
          "path",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "enum": [
        "image"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "valid",
        "valid_with_warnings",
        "invalid"
      ]
    }
  },
  "required": [
    "diagnostics",
    "kind",
    "metadata",
    "prompt",
    "status"
  ],
  "title": "CompilationOutcome",
  "type": "object"
}
